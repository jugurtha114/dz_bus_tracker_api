{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT ST_Y(dp.geom) AS \"lat!\", ST_X(dp.geom) AS \"lng!\"\n            FROM lines l, ST_DumpPoints(l.route::geometry) AS dp\n            WHERE l.id = $1 AND l.route IS NOT NULL\n            ORDER BY dp.path[1]\n            ",
