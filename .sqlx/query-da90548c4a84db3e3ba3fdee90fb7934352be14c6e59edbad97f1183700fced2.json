  "query": "\n            SELECT id, line_id, day_of_week, start_time, end_time, frequency_minutes, is_active,\n                   created_at, updated_at\n            FROM schedules\n            WHERE line_id = $1 AND ($2 OR is_active)\n            ORDER BY day_of_week, start_time, id\n            ",
