  "query": "\n            SELECT u.id, u.email, u.first_name, u.last_name, p.language\n            FROM users u\n            JOIN profiles p ON p.user_id = u.id\n            WHERE u.role = 'admin' AND u.is_active\n            ORDER BY u.email\n            ",
