  "query": "\n            SELECT id, owner_id, purpose, object_key, content_type, size_bytes, status,\n                   created_at, expires_at, attached_at\n            FROM uploads\n            WHERE status = 'pending' AND expires_at < $1\n            ORDER BY expires_at\n            LIMIT $2\n            ",
