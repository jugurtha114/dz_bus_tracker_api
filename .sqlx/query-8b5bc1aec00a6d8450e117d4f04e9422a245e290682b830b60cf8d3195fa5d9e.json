{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT rt.session_id, rt.expires_at, rt.used_at,\n                   s.user_id, s.expires_at AS session_expires_at, s.revoked_at\n            FROM refresh_tokens rt\n            JOIN auth_sessions s ON s.id = rt.session_id\n            WHERE rt.token_hash = $1\n            FOR UPDATE OF rt, s\n            ",
