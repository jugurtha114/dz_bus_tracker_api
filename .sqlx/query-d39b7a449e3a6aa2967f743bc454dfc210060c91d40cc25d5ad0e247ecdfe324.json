  "query": "\n            UPDATE users\n            SET is_active = COALESCE($2, is_active),\n                role = COALESCE($3, role),\n                updated_at = $4\n            WHERE id = $1\n            RETURNING id, email, role, first_name, last_name, phone_number, is_active,\n                      email_verified_at, last_login_at, created_at, updated_at\n            ",
