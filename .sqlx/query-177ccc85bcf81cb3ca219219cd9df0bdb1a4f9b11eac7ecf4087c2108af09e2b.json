  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, driver_id, from_status, to_status, reason, changed_by, created_at\n            FROM driver_status_log\n            WHERE driver_id = $1\n              AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3))\n            ORDER BY created_at DESC, id DESC\n            LIMIT $4\n            ",
