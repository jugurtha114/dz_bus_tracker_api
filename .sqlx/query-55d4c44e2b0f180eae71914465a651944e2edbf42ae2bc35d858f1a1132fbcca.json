  "query": "\n            SELECT id, user_id, created_at, last_used_at, expires_at, user_agent, ip\n            FROM auth_sessions\n            WHERE user_id = $1 AND revoked_at IS NULL AND expires_at > $2\n            ORDER BY last_used_at DESC\n            LIMIT 100\n            ",
