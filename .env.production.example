# =============================================================================
# DZ Bus Tracker — Production Environment Variables
# =============================================================================
# Copy to .env.production and fill in real values:
#   cp .env.production.example .env.production
# =============================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=CHANGE-ME-use-python-c-import-secrets-secrets.token_urlsafe(64)
DEBUG=0
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# --- Database ---
DB_NAME=dz_bus_tracker_db
DB_USER=dz_bus_tracker
DB_PASSWORD=CHANGE-ME-strong-password
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgres://dz_bus_tracker:CHANGE-ME-strong-password@postgres:5432/dz_bus_tracker_db
CONN_MAX_AGE=60

# --- Redis ---
REDIS_PASSWORD=CHANGE-ME-redis-password
# These are set in docker-compose.prod.yml via environment overrides.
# If running outside Docker, set them here:
# CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
# CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@localhost:6379/1
# REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/2

# --- Web Server (Gunicorn + Uvicorn) ---
WEB_PORT=8007
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=2000
GUNICORN_MAX_REQUESTS_JITTER=200
GUNICORN_GRACEFUL_TIMEOUT=30

# --- Celery ---
CELERY_CONCURRENCY=4
CELERY_MAX_TASKS_PER_CHILD=1000
CELERY_PREFETCH_MULTIPLIER=1

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DZ Bus Tracker <no-reply@yourdomain.com>

# --- AWS S3 (media storage) ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-1

# --- Firebase (push notifications) ---
FIREBASE_SERVER_KEY=
FIREBASE_CREDENTIALS_PATH=google-services.json

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- Sentry (error monitoring) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Flower (Celery monitoring — optional) ---
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE-ME

# --- Locale ---
TIME_ZONE=Africa/Algiers
DEFAULT_LANGUAGE=fr
