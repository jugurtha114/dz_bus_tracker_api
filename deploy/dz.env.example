# DZ Bus Tracker — runtime configuration for compose.yaml (copy to deploy/dz.env).
#
# Every setting is DZ_<SECTION>__<KEY>. Unknown DZ_* variables are rejected at start-up, and
# production mode refuses unsafe values (ephemeral keys, plain-HTTP URLs, log mailer...).
# Secrets do NOT belong here: they are files under deploy/secrets/ (deploy/init-secrets.sh),
# passed as DZ_*_FILE variables by compose.yaml.

DZ_ENV=production

# --- HTTP ---------------------------------------------------------------------------------------
# Public URL of the API (OpenAPI `servers`, links).
DZ_HTTP__PUBLIC_BASE_URL=https://api.dzbus.example
# Browser origins allowed by CORS (exact origins, https in production). Empty = no CORS.
DZ_HTTP__CORS_ALLOWED_ORIGINS=[https://app.dzbus.example]
DZ_HTTP__REQUEST_TIMEOUT_SECS=15
DZ_HTTP__BODY_LIMIT_BYTES=1048576
DZ_HTTP__SHUTDOWN_GRACE_SECS=25
# Interactive API reference at /api/docs.
DZ_HTTP__DOCS_ENABLED=true

# --- PostgreSQL / Valkey pools ------------------------------------------------------------------
DZ_DATABASE__MAX_CONNECTIONS=32
DZ_DATABASE__MIN_CONNECTIONS=2
DZ_DATABASE__STATEMENT_TIMEOUT_MS=5000
DZ_VALKEY__POOL_SIZE=8
DZ_VALKEY__KEY_PREFIX=dz:

# --- Authentication -----------------------------------------------------------------------------
# File name (without .pem) of the signing key in deploy/secrets/jwt/. To rotate: add a new key,
# switch this id, restart; remove the old key after the access-token lifetime.
DZ_AUTH__ACTIVE_KEY_ID=CHANGE-ME
DZ_AUTH__ACCESS_TOKEN_TTL_SECS=900
DZ_AUTH__REFRESH_TOKEN_TTL_SECS=1209600
DZ_AUTH__SESSION_MAX_LIFETIME_SECS=5184000
DZ_AUTH__PASSWORD_MIN_LENGTH=12
DZ_AUTH__LOCKOUT_THRESHOLD=5
DZ_AUTH__LOCKOUT_BASE_SECS=60
# Front-end page that completes password resets (token appended as #token=...).
DZ_AUTH__PASSWORD_RESET_URL=https://app.dzbus.example/reset-password

# --- Rate limits (requests per minute, per user / API key / client IP) ---------------------------
DZ_RATE_LIMIT__ANON_PER_MINUTE=30
DZ_RATE_LIMIT__USER_PER_MINUTE=60
DZ_RATE_LIMIT__BURST=60
DZ_RATE_LIMIT__LOCATION_PER_MINUTE=100
DZ_RATE_LIMIT__AUTH_PER_MINUTE=10
DZ_RATE_LIMIT__SERVICE_PER_MINUTE=1200

# --- E-mail (the SMTP URL with credentials is the smtp_url secret) -------------------------------
DZ_EMAIL__TRANSPORT=smtp
DZ_EMAIL__FROM=DZ Bus Tracker <noreply@dzbus.example>

# --- Worker -------------------------------------------------------------------------------------
DZ_WORKER__CONCURRENCY=4
DZ_WORKER__RETENTION_DAYS=7

# --- Telemetry ----------------------------------------------------------------------------------
DZ_TELEMETRY__LOG_FORMAT=json
DZ_TELEMETRY__LOG_FILTER=info,sqlx=warn,fred=warn
# OTLP/HTTP traces (optional), e.g. http://otel-collector:4318/v1/traces
# DZ_TELEMETRY__OTLP_ENDPOINT=
# DZ_TELEMETRY__OTLP_SAMPLE_RATIO=0.1
